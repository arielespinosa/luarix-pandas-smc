// =====================================================================================
// CONSUMO 4H — usa los valores de dailyEngine() (vía request.security más abajo) para
// replicar exist_equals()/exist_orderblock()/calc_strategy_score() de strategy.py.
// =====================================================================================

// @function            puerto de exist_equals(): se detiene en el PRIMER Equal Low que
//                       el low del tick actual rompe, sea sweep válido (close recupera
//                       el nivel) o falso quiebre (close se queda por debajo) — no sigue
//                       revisando los siguientes niveles aunque el primero ya decida.
//                       También devuelve el timestamp diario de ese nivel, para poder
//                       dibujarlo anclado a su origen real (no solo cerca de la barra
//                       4H actual).
// @returns             [precio del Equal Low barrido (o na), su timestamp diario]
existEquals4h(float e1, float e2, float e3, float e4, float e5, int t1, int t2, int t3, int t4, int t5) =>
    float result     = na
    int   resultTime = na
    bool  decided    = false
    if not decided and not na(e1) and low < e1
        result     := close > e1 ? e1 : na
        resultTime := close > e1 ? t1 : na
        decided    := true
    if not decided and not na(e2) and low < e2
        result     := close > e2 ? e2 : na
        resultTime := close > e2 ? t2 : na
        decided    := true
    if not decided and not na(e3) and low < e3
        result     := close > e3 ? e3 : na
        resultTime := close > e3 ? t3 : na
        decided    := true
    if not decided and not na(e4) and low < e4
        result     := close > e4 ? e4 : na
        resultTime := close > e4 ? t4 : na
        decided    := true
    if not decided and not na(e5) and low < e5
        result     := close > e5 ? e5 : na
        resultTime := close > e5 ? t5 : na
        decided    := true
    [result, resultTime]

// @function            puerto de exist_orderblock(): los slots vienen pre-ordenados por
//                       top descendente desde dailyEngine(), así que el primero que
//                       matchea (top < equalPrice) ya es el máximo.
// @returns             [obTop, obBot, obTime, obBias]
existOrderblock4h(float equalPrice, float t1, float b1, int tm1, int bi1, float t2, float b2, int tm2, int bi2, float t3, float b3, int tm3, int bi3, float t4, float b4, int tm4, int bi4, float t5, float b5, int tm5, int bi5) =>
    float bestTop  = na
    float bestBot  = na
    int   bestTime = na
    int   bestBias = na
    if not na(equalPrice)
        if not na(t1) and t1 < equalPrice
            bestTop := t1
            bestBot := b1
            bestTime := tm1
            bestBias := bi1
        else if not na(t2) and t2 < equalPrice
            bestTop := t2
            bestBot := b2
            bestTime := tm2
            bestBias := bi2
        else if not na(t3) and t3 < equalPrice
            bestTop := t3
            bestBot := b3
            bestTime := tm3
            bestBias := bi3
        else if not na(t4) and t4 < equalPrice
            bestTop := t4
            bestBot := b4
            bestTime := tm4
            bestBias := bi4
        else if not na(t5) and t5 < equalPrice
            bestTop := t5
            bestBot := b5
            bestTime := tm5
            bestBias := bi5
    [bestTop, bestBot, bestTime, bestBias]

// @function            divergencia alcista del estocástico — puerto de
//                       stochastic_oscillator_have_divergence() en strategy.py, con
//                       ventana fija (ver stochasticDivLenInput, aproximación
//                       documentada en docs/plans/bugs.md).
// @returns             bool
stochDivergence(float slowK, int divLen) =>
    mid     = divLen / 2
    priceL1 = ta.lowest(close, mid)
    priceL2 = ta.lowest(close[mid], mid)
    kL1     = ta.lowest(slowK, mid)
    kL2     = ta.lowest(slowK[mid], mid)
    priceL1 < priceL2 and kL1 > kL2

// @function            score ponderado — pesos confirmados contra strategy.py (ver
//                       docs/plans/bugs.md): Equal Lows +35, Order Block +25,
//                       Divergencia +20, Sobreventa +15, BB50 +15, tendencia +10.
//                       Simplificado LONG-only: se gatea con trendBias == 1 en el
//                       bloque de la señal, no se replica la rama BEARISH de Python
//                       (esa solo alimenta señales SHORT, fuera de alcance).
// @returns             int
calcScore4h(float equalPrice, bool obValid, bool divergence, bool oversold, bool bbTouch, int trendBias) =>
    hasEqual = not na(equalPrice)
    score = 0
    score := hasEqual    ? score + 35 : score
    score := obValid     ? score + 25 : score
    score := divergence  ? score + 20 : score
    score := oversold    ? score + 15 : score
    score := bbTouch     ? score + 15 : score
    score := trendBias == 1 ? score + 10 : score
    score

// @function            update trailing swing points
// @returns             int
updateTrailingExtremes() =>
    trailing.top            := math.max(high,trailing.top)
    trailing.lastTopTime    := trailing.top == high ? time : trailing.lastTopTime
    trailing.bottom         := math.min(low,trailing.bottom)
    trailing.lastBottomTime := trailing.bottom == low ? time : trailing.lastBottomTime

// @function            draw trailing swing points
// @returns             void
drawHighLowSwings() =>
    var line topLine        = line.new(na, na, na, na, color = swingBearishColor, xloc = xloc.bar_time)
    var line bottomLine     = line.new(na, na, na, na, color = swingBullishColor, xloc = xloc.bar_time)
    var label topLabel      = label.new(na, na, color=color(na), textcolor = swingBearishColor, xloc = xloc.bar_time, style = label.style_label_down, size = size.tiny)
    var label bottomLabel   = label.new(na, na, color=color(na), textcolor = swingBullishColor, xloc = xloc.bar_time, style = label.style_label_up, size = size.tiny)

    rightTimeBar            = last_bar_time + 20 * (time - time[1])

    topLine.set_first_point(    chart.point.new(trailing.lastTopTime, na, trailing.top))
    topLine.set_second_point(   chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_point(         chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_text(          swingTrend.bias == BEARISH ? 'Strong High' : 'Weak High')

    bottomLine.set_first_point( chart.point.new(trailing.lastBottomTime, na, trailing.bottom))
    bottomLine.set_second_point(chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_point(      chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_text(       swingTrend.bias == BULLISH ? 'Strong Low' : 'Weak Low')

// @function            draw a zone with a label and a box
// @param labelLevel    price level for label
// @param labelIndex    bar index for label
// @param top           top price level for box
// @param bottom        bottom price level for box
// @param tag           text to display
// @param zoneColor     base color
// @param style         label style
// @returns             void
drawZone(float labelLevel, int labelIndex, float top, float bottom, string tag, color zoneColor, string style) =>
    var label l_abel    = label.new(na,na,text = tag, color=color(na),textcolor = zoneColor, style = style, size = size.small)
    var box b_ox        = box.new(na,na,na,na,bgcolor = color.new(zoneColor,80),border_color = color(na), xloc = xloc.bar_time)

    b_ox.set_top_left_point(    chart.point.new(trailing.barTime,na,top))
    b_ox.set_bottom_right_point(chart.point.new(last_bar_time,na,bottom))

    l_abel.set_point(           chart.point.new(na,labelIndex,labelLevel))

// @function            draw premium/discount zones
// @returns             void
drawPremiumDiscountZones() =>
    drawZone(trailing.top, math.round(0.5*(trailing.barIndex + last_bar_index)), trailing.top, 0.95*trailing.top + 0.05*trailing.bottom, 'Premium', premiumZoneColor, label.style_label_down)

    equilibriumLevel = math.avg(trailing.top, trailing.bottom)
    drawZone(equilibriumLevel, last_bar_index, 0.525*trailing.top + 0.475*trailing.bottom, 0.525*trailing.bottom + 0.475*trailing.top, 'Equilibrium', equilibriumZoneColorInput, label.style_label_left)

    drawZone(trailing.bottom, math.round(0.5*(trailing.barIndex + last_bar_index)), 0.95*trailing.bottom + 0.05*trailing.top, trailing.bottom, 'Discount', discountZoneColor, label.style_label_up)

// =====================================================================================
// DIBUJO DE LA VISUALIZACIÓN RESTAURADA DESDE dailyEngine() — EQL/EQH, Order Blocks
// crudos (interno/swing por separado), eventos de estructura BOS/CHoCH, puntos swing
// HH/HL/LH/LL. Mismo patrón ya probado en el fichero: objetos var creados una vez en
// barstate.isfirst, repositionados cada barra; un slot con dato na se deja en su última
// posición (no se "esconde"). Funciones top-level porque reciben arrays por parámetro
// (mismo motivo que storeObDaily/deleteObDaily — Pine no permite funciones anidadas).
// Helpers compartidos entre interno/swing donde la forma del dato es idéntica. Ver
// docs/plans/bugs.md para el detalle de diseño.
// =====================================================================================

// @function            reposiciona un cupo de cajas de Order Block crudas (sin fusionar)
//                       — usado tanto para internas como para swing.
// @returns             void
drawObBoxSetD(array<box> boxes, array<float> tops, array<float> bots, array<int> times, array<int> biases, color bullColor, color bearColor) =>
    // min(boxes,tops): si internalOrderBlocksSizeInput/swingOrderBlocksSizeInput se
    // configura por encima del cupo del motor diario (5), boxes tendría más elementos
    // que tops — sin este clamp, array.get(tops, i) rompería fuera de rango.
    n = math.min(array.size(boxes), array.size(tops))
    if n > 0
        for i = 0 to n - 1
            t = array.get(tops, i)
            if not na(t)
                bx = array.get(boxes, i)
                b  = array.get(bots, i)
                tm = array.get(times, i)
                bi = array.get(biases, i)
                obColor = bi == BEARISH ? bearColor : bullColor
                bx.set_top_left_point(chart.point.new(tm, na, t))
                bx.set_bottom_right_point(chart.point.new(last_bar_time, na, b))
                bx.set_border_color(obColor)
                bx.set_bgcolor(obColor)

// @function            reposiciona un cupo de líneas+labels de Equal Highs/Lows — usado
//                       tanto para EQL como para EQH. Segmento FIJO entre el pivot de
//                       ORIGEN y el de confirmación (igual que drawEqualHighLow() nativo:
//                       línea de p_ivot.barTime a time[size], label centrado a la mitad) —
//                       NO un punto único con extend.right como en el primer intento
//                       (causa raíz del bug "solo aparece el elemento"/texto corrido, ver
//                       docs/plans/bugs.md). El centrado usa tiempo medio (xloc.bar_time),
//                       no bar_index medio como el nativo, porque acá el dato es diario y
//                       el chart puede estar en otro timeframe (4H, etc.).
// @returns             void
drawLevelSetD(array<line> lines, array<label> labels, array<float> prices, array<int> origins, array<int> times, string tag, color lvlColor, string labelSize) =>
    n = array.size(lines)
    if n > 0
        for i = 0 to n - 1
            p = array.get(prices, i)
            if not na(p)
                org = array.get(origins, i)
                tm  = array.get(times, i)
                ln  = array.get(lines, i)
                lb  = array.get(labels, i)
                // Pine: "/" siempre devuelve float aunque ambos operandos sean int —
                // chart.point.new exige "int" para el tiempo, de ahí el cast explícito
                // (sin él, "series float was used but series int expected").
                midTime = int(org + math.round((tm - org) / 2))
                ln.set_first_point(chart.point.new(org, na, p))
                ln.set_second_point(chart.point.new(tm, na, p))
                ln.set_color(lvlColor)
                lb.set_point(chart.point.new(midTime, na, p))
                lb.set_text(tag)
                lb.set_textcolor(lvlColor)
                lb.set_size(labelSize)

// @function            reposiciona un cupo de eventos de estructura BOS/CHoCH — línea
//                       FIJA (sin extend, a diferencia de EQL/EQH) desde el origen del
//                       pivot roto hasta el momento del quiebre, igual que drawStructure()
//                       nativo. Respeta el filtro ALL/BOS/CHOCH (showInternalBullInput/
//                       showInternalBearInput o sus equivalentes swing) — un evento que no
//                       matchea el filtro se oculta (línea transparente, label vacío).
// @returns             void
drawStructEventSetD(array<line> lines, array<label> labels, array<string> tags, array<int> biases, array<float> levels, array<int> origins, array<int> breaks, string bullFilterInput, string bearFilterInput, color bullColor, color bearColor, string labelSize) =>
    n = array.size(lines)
    if n > 0
        for i = 0 to n - 1
            lvl = array.get(levels, i)
            if not na(lvl)
                tag  = array.get(tags, i)
                bias = array.get(biases, i)
                org  = array.get(origins, i)
                brk  = array.get(breaks, i)
                ln   = array.get(lines, i)
                lb   = array.get(labels, i)
                filterInput = bias == BULLISH ? bullFilterInput : bearFilterInput
                visible = filterInput == ALL or (filterInput == BOS and tag != CHOCH) or (filterInput == CHOCH and tag == CHOCH)
                eventColor = bias == BULLISH ? bullColor : bearColor
                if visible
                    // Label centrado en el tiempo medio entre origen y quiebre — igual
                    // que drawStructure() nativo (math.round(0.5*(p_ivot.barIndex+bar_index))),
                    // adaptado a tiempo real en vez de bar_index (ver docs/plans/bugs.md).
                    // Mismo cast explícito que en drawLevelSetD — "/" da float aunque
                    // brk/org sean int, y chart.point.new exige int para el tiempo.
                    midTime = int(org + math.round((brk - org) / 2))
                    ln.set_first_point(chart.point.new(org, na, lvl))
                    ln.set_second_point(chart.point.new(brk, na, lvl))
                    ln.set_color(eventColor)
                    lb.set_point(chart.point.new(midTime, na, lvl))
                    lb.set_text(tag)
                    lb.set_textcolor(eventColor)
                    lb.set_style(bias == BULLISH ? label.style_label_down : label.style_label_up)
                    lb.set_size(labelSize)
                else
                    ln.set_color(color(na))
                    lb.set_text('')

// @function            reposiciona un cupo de labels de puntos swing HH/HL/LH/LL — solo
//                       aplica a la estructura SWING (50 velas), igual que el nativo.
// @returns             void
drawSwingPointSetD(array<label> labels, array<string> tags, array<float> levels, array<int> times, color bullColor, color bearColor, string labelSize) =>
    n = array.size(labels)
    if n > 0
        for i = 0 to n - 1
            lvl = array.get(levels, i)
            if not na(lvl)
                tag = array.get(tags, i)
                tm  = array.get(times, i)
                lb  = array.get(labels, i)
                isLow = tag == 'LL' or tag == 'HL'
                pointColor = isLow ? bullColor : bearColor
                lb.set_point(chart.point.new(tm, na, lvl))
                lb.set_text(tag)
                lb.set_textcolor(pointColor)
                lb.set_style(isLow ? label.style_label_up : label.style_label_down)
                lb.set_size(labelSize)

//---------------------------------------------------------------------------------------------------------------------}
//MUTABLE VARIABLES & EXECUTION
//---------------------------------------------------------------------------------------------------------------------{
parsedOpen  = showTrendInput ? open : na
candleColor = internalTrend.bias == BULLISH ? swingBullishColor : swingBearishColor
plotcandle(parsedOpen,high,low,close,color = candleColor, wickcolor = candleColor, bordercolor = candleColor)

if showHighLowSwingsInput or showPremiumDiscountZonesInput
    updateTrailingExtremes()

    if showHighLowSwingsInput
        drawHighLowSwings()

    if showPremiumDiscountZonesInput
        drawPremiumDiscountZones()

if showFairValueGapsInput
    deleteFairValueGaps()

// Estructura (swing/internal/equal pivots, BOS/CHoCH, Order Blocks) YA NO se calcula
// ni se dibuja en el timeframe del chart — se reemplazó por dailyEngine() vía
// request.security("D", ...) más abajo, que es ahora la única fuente de verdad (mismo
// valor/forma sin importar el timeframe del chart, ver docs/plans/pine-strategy-
// rearchitecture.md y el plan de esta sesión). internalTrend/swingTrend/swingHigh/Low/
// internalHigh/Low/los arrays de Order Blocks nativos quedan sin usar a propósito —
// no se borraron sus declaraciones para no tocar más de lo necesario, pero ya no se
// alimentan (candleColor arriba, que lee internalTrend.bias, queda "congelado" en su
// último valor — aceptado, no es parte del alcance de este cambio).

// dTrend: 1 = alcista, -1 = bajista, 0 = sin tendencia interna confirmada todavía
// (igual semántica que context.trend is None en Python — sin tendencia, no se opera).
[dTrend,
 eql1, eql2, eql3, eql4, eql5, eqlT1, eqlT2, eqlT3, eqlT4, eqlT5,
 ob1Top, ob1Bot, ob1T, ob1B, ob2Top, ob2Bot, ob2T, ob2B, ob3Top, ob3Bot, ob3T, ob3B,
 ob4Top, ob4Bot, ob4T, ob4B, ob5Top, ob5Bot, ob5T, ob5B,
 eql6, eql7, eql8, eql9, eql10, eql11, eql12, eql13, eql14, eql15, eql16, eql17, eql18, eql19, eql20,
 eqlT6, eqlT7, eqlT8, eqlT9, eqlT10, eqlT11, eqlT12, eqlT13, eqlT14, eqlT15, eqlT16, eqlT17, eqlT18, eqlT19, eqlT20,
 eqlOrgT1, eqlOrgT2, eqlOrgT3, eqlOrgT4, eqlOrgT5, eqlOrgT6, eqlOrgT7, eqlOrgT8, eqlOrgT9, eqlOrgT10, eqlOrgT11, eqlOrgT12, eqlOrgT13, eqlOrgT14, eqlOrgT15, eqlOrgT16, eqlOrgT17, eqlOrgT18, eqlOrgT19, eqlOrgT20,
 eqh1, eqh2, eqh3, eqh4, eqh5, eqh6, eqh7, eqh8, eqh9, eqh10, eqh11, eqh12, eqh13, eqh14, eqh15, eqh16, eqh17, eqh18, eqh19, eqh20,
 eqhT1, eqhT2, eqhT3, eqhT4, eqhT5, eqhT6, eqhT7, eqhT8, eqhT9, eqhT10, eqhT11, eqhT12, eqhT13, eqhT14, eqhT15, eqhT16, eqhT17, eqhT18, eqhT19, eqhT20,
 eqhOrgT1, eqhOrgT2, eqhOrgT3, eqhOrgT4, eqhOrgT5, eqhOrgT6, eqhOrgT7, eqhOrgT8, eqhOrgT9, eqhOrgT10, eqhOrgT11, eqhOrgT12, eqhOrgT13, eqhOrgT14, eqhOrgT15, eqhOrgT16, eqhOrgT17, eqhOrgT18, eqhOrgT19, eqhOrgT20,
 iob1Top, iob1Bot, iob1T, iob1B, iob2Top, iob2Bot, iob2T, iob2B, iob3Top, iob3Bot, iob3T, iob3B, iob4Top, iob4Bot, iob4T, iob4B, iob5Top, iob5Bot, iob5T, iob5B,
 iob6Top, iob6Bot, iob6T, iob6B, iob7Top, iob7Bot, iob7T, iob7B, iob8Top, iob8Bot, iob8T, iob8B, iob9Top, iob9Bot, iob9T, iob9B, iob10Top, iob10Bot, iob10T, iob10B,
 iob11Top, iob11Bot, iob11T, iob11B, iob12Top, iob12Bot, iob12T, iob12B, iob13Top, iob13Bot, iob13T, iob13B, iob14Top, iob14Bot, iob14T, iob14B, iob15Top, iob15Bot, iob15T, iob15B,
 iob16Top, iob16Bot, iob16T, iob16B, iob17Top, iob17Bot, iob17T, iob17B, iob18Top, iob18Bot, iob18T, iob18B, iob19Top, iob19Bot, iob19T, iob19B, iob20Top, iob20Bot, iob20T, iob20B,
 sob1Top, sob1Bot, sob1T, sob1B, sob2Top, sob2Bot, sob2T, sob2B, sob3Top, sob3Bot, sob3T, sob3B, sob4Top, sob4Bot, sob4T, sob4B, sob5Top, sob5Bot, sob5T, sob5B,
 sob6Top, sob6Bot, sob6T, sob6B, sob7Top, sob7Bot, sob7T, sob7B, sob8Top, sob8Bot, sob8T, sob8B, sob9Top, sob9Bot, sob9T, sob9B, sob10Top, sob10Bot, sob10T, sob10B,
 sob11Top, sob11Bot, sob11T, sob11B, sob12Top, sob12Bot, sob12T, sob12B, sob13Top, sob13Bot, sob13T, sob13B, sob14Top, sob14Bot, sob14T, sob14B, sob15Top, sob15Bot, sob15T, sob15B,
 sob16Top, sob16Bot, sob16T, sob16B, sob17Top, sob17Bot, sob17T, sob17B, sob18Top, sob18Bot, sob18T, sob18B, sob19Top, sob19Bot, sob19T, sob19B, sob20Top, sob20Bot, sob20T, sob20B,
 ie1Tag, ie1Bias, ie1Lvl, ie1Org, ie1Brk, ie2Tag, ie2Bias, ie2Lvl, ie2Org, ie2Brk, ie3Tag, ie3Bias, ie3Lvl, ie3Org, ie3Brk, ie4Tag, ie4Bias, ie4Lvl, ie4Org, ie4Brk, ie5Tag, ie5Bias, ie5Lvl, ie5Org, ie5Brk,
 ie6Tag, ie6Bias, ie6Lvl, ie6Org, ie6Brk, ie7Tag, ie7Bias, ie7Lvl, ie7Org, ie7Brk, ie8Tag, ie8Bias, ie8Lvl, ie8Org, ie8Brk, ie9Tag, ie9Bias, ie9Lvl, ie9Org, ie9Brk, ie10Tag, ie10Bias, ie10Lvl, ie10Org, ie10Brk,
 se1Tag, se1Bias, se1Lvl, se1Org, se1Brk, se2Tag, se2Bias, se2Lvl, se2Org, se2Brk, se3Tag, se3Bias, se3Lvl, se3Org, se3Brk, se4Tag, se4Bias, se4Lvl, se4Org, se4Brk, se5Tag, se5Bias, se5Lvl, se5Org, se5Brk,
 se6Tag, se6Bias, se6Lvl, se6Org, se6Brk, se7Tag, se7Bias, se7Lvl, se7Org, se7Brk, se8Tag, se8Bias, se8Lvl, se8Org, se8Brk, se9Tag, se9Bias, se9Lvl, se9Org, se9Brk, se10Tag, se10Bias, se10Lvl, se10Org, se10Brk,
 sp1Tag, sp1Lvl, sp1Tm, sp2Tag, sp2Lvl, sp2Tm, sp3Tag, sp3Lvl, sp3Tm, sp4Tag, sp4Lvl, sp4Tm, sp5Tag, sp5Lvl, sp5Tm, sp6Tag, sp6Lvl, sp6Tm, sp7Tag, sp7Lvl, sp7Tm, sp8Tag, sp8Lvl, sp8Tm, sp9Tag, sp9Lvl, sp9Tm, sp10Tag, sp10Lvl, sp10Tm] = request.security(syminfo.tickerid, "D", dailyEngine(), lookahead = barmerge.lookahead_off)

if showFairValueGapsInput
    drawFairValueGaps()

// Order Blocks internos/swing — antes llamaban a drawOrderBlocks(internal), que lee de
// los arrays orderBlock NATIVOS (internalOrderBlocks/swingOrderBlocks), nunca poblados
// desde que se desactivó el motor nativo (no-op silencioso). Ahora reposicionan las
// MISMAS cajas (internalOrderBlocksBoxes/swingOrderBlocksBoxes, creadas arriba en
// barstate.isfirst) con los datos CRUDOS de dailyEngine() (iob1..5/sob1..5) — ver
// docs/plans/bugs.md. Cada barra, no solo al final del histórico (igual que el resto
// de la visualización diaria ya restaurada).
if showInternalOrderBlocksInput
    drawObBoxSetD(internalOrderBlocksBoxes, array.from(iob1Top,iob2Top,iob3Top,iob4Top,iob5Top,iob6Top,iob7Top,iob8Top,iob9Top,iob10Top,iob11Top,iob12Top,iob13Top,iob14Top,iob15Top,iob16Top,iob17Top,iob18Top,iob19Top,iob20Top), array.from(iob1Bot,iob2Bot,iob3Bot,iob4Bot,iob5Bot,iob6Bot,iob7Bot,iob8Bot,iob9Bot,iob10Bot,iob11Bot,iob12Bot,iob13Bot,iob14Bot,iob15Bot,iob16Bot,iob17Bot,iob18Bot,iob19Bot,iob20Bot), array.from(iob1T,iob2T,iob3T,iob4T,iob5T,iob6T,iob7T,iob8T,iob9T,iob10T,iob11T,iob12T,iob13T,iob14T,iob15T,iob16T,iob17T,iob18T,iob19T,iob20T), array.from(iob1B,iob2B,iob3B,iob4B,iob5B,iob6B,iob7B,iob8B,iob9B,iob10B,iob11B,iob12B,iob13B,iob14B,iob15B,iob16B,iob17B,iob18B,iob19B,iob20B), internalBullishOrderBlockColor, internalBearishOrderBlockColor)

if showSwingOrderBlocksInput
    drawObBoxSetD(swingOrderBlocksBoxes, array.from(sob1Top,sob2Top,sob3Top,sob4Top,sob5Top,sob6Top,sob7Top,sob8Top,sob9Top,sob10Top,sob11Top,sob12Top,sob13Top,sob14Top,sob15Top,sob16Top,sob17Top,sob18Top,sob19Top,sob20Top), array.from(sob1Bot,sob2Bot,sob3Bot,sob4Bot,sob5Bot,sob6Bot,sob7Bot,sob8Bot,sob9Bot,sob10Bot,sob11Bot,sob12Bot,sob13Bot,sob14Bot,sob15Bot,sob16Bot,sob17Bot,sob18Bot,sob19Bot,sob20Bot), array.from(sob1T,sob2T,sob3T,sob4T,sob5T,sob6T,sob7T,sob8T,sob9T,sob10T,sob11T,sob12T,sob13T,sob14T,sob15T,sob16T,sob17T,sob18T,sob19T,sob20T), array.from(sob1B,sob2B,sob3B,sob4B,sob5B,sob6B,sob7B,sob8B,sob9B,sob10B,sob11B,sob12B,sob13B,sob14B,sob15B,sob16B,sob17B,sob18B,sob19B,sob20B), swingBullishOrderBlockColor, swingBearishOrderBlockColor)

// Equal Lows/Highs — línea punteada extendida a la derecha + label 'EQL'/'EQH'.
if showEqualHighsLowsInput
    drawLevelSetD(eqlLinesD, eqlLabelsD, array.from(eql1,eql2,eql3,eql4,eql5,eql6,eql7,eql8,eql9,eql10,eql11,eql12,eql13,eql14,eql15,eql16,eql17,eql18,eql19,eql20), array.from(eqlOrgT1,eqlOrgT2,eqlOrgT3,eqlOrgT4,eqlOrgT5,eqlOrgT6,eqlOrgT7,eqlOrgT8,eqlOrgT9,eqlOrgT10,eqlOrgT11,eqlOrgT12,eqlOrgT13,eqlOrgT14,eqlOrgT15,eqlOrgT16,eqlOrgT17,eqlOrgT18,eqlOrgT19,eqlOrgT20), array.from(eqlT1,eqlT2,eqlT3,eqlT4,eqlT5,eqlT6,eqlT7,eqlT8,eqlT9,eqlT10,eqlT11,eqlT12,eqlT13,eqlT14,eqlT15,eqlT16,eqlT17,eqlT18,eqlT19,eqlT20), 'EQL', swingBullishColor, equalHighsLowsSizeInput)
    drawLevelSetD(eqhLinesD, eqhLabelsD, array.from(eqh1,eqh2,eqh3,eqh4,eqh5,eqh6,eqh7,eqh8,eqh9,eqh10,eqh11,eqh12,eqh13,eqh14,eqh15,eqh16,eqh17,eqh18,eqh19,eqh20), array.from(eqhOrgT1,eqhOrgT2,eqhOrgT3,eqhOrgT4,eqhOrgT5,eqhOrgT6,eqhOrgT7,eqhOrgT8,eqhOrgT9,eqhOrgT10,eqhOrgT11,eqhOrgT12,eqhOrgT13,eqhOrgT14,eqhOrgT15,eqhOrgT16,eqhOrgT17,eqhOrgT18,eqhOrgT19,eqhOrgT20), array.from(eqhT1,eqhT2,eqhT3,eqhT4,eqhT5,eqhT6,eqhT7,eqhT8,eqhT9,eqhT10,eqhT11,eqhT12,eqhT13,eqhT14,eqhT15,eqhT16,eqhT17,eqhT18,eqhT19,eqhT20), 'EQH', swingBearishColor, equalHighsLowsSizeInput)

// Estructura BOS/CHoCH — interna (5 velas) y swing (50 velas), cupo 3 eventos cada una.
if showInternalsInput
    drawStructEventSetD(internalStructLinesD, internalStructLabelsD, array.from(ie1Tag,ie2Tag,ie3Tag,ie4Tag,ie5Tag,ie6Tag,ie7Tag,ie8Tag,ie9Tag,ie10Tag), array.from(ie1Bias,ie2Bias,ie3Bias,ie4Bias,ie5Bias,ie6Bias,ie7Bias,ie8Bias,ie9Bias,ie10Bias), array.from(ie1Lvl,ie2Lvl,ie3Lvl,ie4Lvl,ie5Lvl,ie6Lvl,ie7Lvl,ie8Lvl,ie9Lvl,ie10Lvl), array.from(ie1Org,ie2Org,ie3Org,ie4Org,ie5Org,ie6Org,ie7Org,ie8Org,ie9Org,ie10Org), array.from(ie1Brk,ie2Brk,ie3Brk,ie4Brk,ie5Brk,ie6Brk,ie7Brk,ie8Brk,ie9Brk,ie10Brk), showInternalBullInput, showInternalBearInput, internalBullColorInput, internalBearColorInput, internalStructureSize)

if showStructureInput
    drawStructEventSetD(swingStructLinesD, swingStructLabelsD, array.from(se1Tag,se2Tag,se3Tag,se4Tag,se5Tag,se6Tag,se7Tag,se8Tag,se9Tag,se10Tag), array.from(se1Bias,se2Bias,se3Bias,se4Bias,se5Bias,se6Bias,se7Bias,se8Bias,se9Bias,se10Bias), array.from(se1Lvl,se2Lvl,se3Lvl,se4Lvl,se5Lvl,se6Lvl,se7Lvl,se8Lvl,se9Lvl,se10Lvl), array.from(se1Org,se2Org,se3Org,se4Org,se5Org,se6Org,se7Org,se8Org,se9Org,se10Org), array.from(se1Brk,se2Brk,se3Brk,se4Brk,se5Brk,se6Brk,se7Brk,se8Brk,se9Brk,se10Brk), showSwingBullInput, showSwingBearInput, swingBullColorInput, swingBearColorInput, swingStructureSize)

// Puntos swing HH/HL/LH/LL — solo estructura swing, igual que el nativo.
if showSwingsInput
    drawSwingPointSetD(swingPointLabelsD, array.from(sp1Tag,sp2Tag,sp3Tag,sp4Tag,sp5Tag,sp6Tag,sp7Tag,sp8Tag,sp9Tag,sp10Tag), array.from(sp1Lvl,sp2Lvl,sp3Lvl,sp4Lvl,sp5Lvl,sp6Lvl,sp7Lvl,sp8Lvl,sp9Lvl,sp10Lvl), array.from(sp1Tm,sp2Tm,sp3Tm,sp4Tm,sp5Tm,sp6Tm,sp7Tm,sp8Tm,sp9Tm,sp10Tm), swingBullishColor, swingBearishColor, swingStructureSize)

lastBarIndex    := currentBarIndex
currentBarIndex := bar_index
newBar          = currentBarIndex != lastBarIndex

if barstate.islastconfirmedhistory or (barstate.isrealtime and newBar)
    if showDailyLevelsInput and not higherTimeframe('D')
        drawLevels('D',timeframe.isdaily,dailyLevelsStyleInput,dailyLevelsColorInput)

    if showWeeklyLevelsInput and not higherTimeframe('W')
        drawLevels('W',timeframe.isweekly,weeklyLevelsStyleInput,weeklyLevelsColorInput)

    if showMonthlyLevelsInput and not higherTimeframe('M')
        drawLevels('M',timeframe.ismonthly,monthlyLevelsStyleInput,monthlyLevelsColorInput)

// Annual NO usa drawLevels()/request.security('12M', ...) — ver nota junto a
// annualHigh/annualLow/annualYear más arriba (la barra sintética "12M" no es
// fiable, queda pegada a un año viejo). Se dibuja con drawAnnualLevel(), llamada
// SIN el gate de barstate que usa Daily/Weekly/Monthly: ese gate solo se cumple
// al cargar histórico o con barras nuevas en tiempo real/replay — al detener el
// Replay deja de cumplirse y la línea quedaba congelada en el último año donde
// sí se había dibujado. Llamándolo en cada barra, siempre refleja la última
// barra procesada, esté el chart corriendo, detenido, o en replay.
if showAnnualLevelsInput
    drawAnnualLevel(annualLevelsColorInput, annualLevelsStyleInput)

// Stochastic Oscillator — cálculo cada barra (necesario para detectar cruces con
// ta.crossover/crossunder) y marcadores compatibles con overlay=true: triángulo
// abajo de la vela al ENTRAR en sobreventa, triángulo arriba al ENTRAR en
// sobrecompra. slowK/fastD quedan disponibles para cuando la estrategia los use
// en el score (igual que is_stochastic_oscillator_in_over_sell en strategy.py).
[stochK, stochD] = stochasticOscillator(stochasticLengthInput, stochasticDLengthInput)

stochEnterOversold   = showStochasticInput and ta.crossunder(stochK, stochasticLowerInput)
stochEnterOverbought = showStochasticInput and ta.crossover(stochK, stochasticUpperInput)

plotshape(stochEnterOversold   ? low  : na, title = 'Stochastic Oversold',   style = shape.triangleup,   location = location.belowbar, color = stochasticBullColorInput, size = size.tiny)
plotshape(stochEnterOverbought ? high : na, title = 'Stochastic Overbought', style = shape.triangledown, location = location.abovebar, color = stochasticBearColorInput, size = size.tiny)

// BB50 — mismas bandas en escala de precio, compatibles con overlay=true sin
// necesitar ningún workaround (a diferencia del Stochastic). plot()/fill() ya
// manejan na correctamente cuando showBB50Input está apagado.
// ta.bb() se llama DIRECTO aquí (no envuelto en una función propia) porque su
// parámetro mult exige "simple float" — al pasarlo por un parámetro de función
// definida por el usuario, Pine lo eleva a "series float" y rompe la llamada
// ("argument of 'series float' type was used but a 'simple float' is expected").
// ta.bb() ya devuelve [basis/middle, upper, lower] — NO [upper, middle, lower]
// (confusión que costó un bug real en v2, ver docs/plans/bugs.md).
[bb50Basis, bb50Upper, bb50Lower] = ta.bb(close, bb50LengthInput, bb50MultInput)

bb50UpperPlot = plot(showBB50Input ? bb50Upper : na, title = 'BB50 Upper', color = color.new(bb50ColorInput, 70), linewidth = 1)
bb50BasisPlot = plot(showBB50Input ? bb50Basis : na, title = 'BB50 Basis', color = color.new(bb50ColorInput, 40), linewidth = 1)
bb50LowerPlot = plot(showBB50Input ? bb50Lower : na, title = 'BB50 Lower', color = color.new(bb50ColorInput, 70), linewidth = 1)
fill(bb50UpperPlot, bb50LowerPlot, color.new(bb50ColorInput, 95))

// ---- Consumo 4H: Equal Low barrido, Order Block matching, divergencia, sobreventa,
// BB50 y score — alimentados por dTrend/eql*/ob* que vienen de dailyEngine() más
// arriba. VISUAL ÚNICAMENTE — no manda ninguna orden real (ver scoreThresholdInput). ----
[eqlPrice4h, eqlTime4h] = existEquals4h(eql1, eql2, eql3, eql4, eql5, eqlT1, eqlT2, eqlT3, eqlT4, eqlT5)
[obTop4h, obBot4h, obTime4h, obBias4h] = existOrderblock4h(eqlPrice4h, ob1Top, ob1Bot, ob1T, ob1B, ob2Top, ob2Bot, ob2T, ob2B, ob3Top, ob3Bot, ob3T, ob3B, ob4Top, ob4Bot, ob4T, ob4B, ob5Top, ob5Bot, ob5T, ob5B)
obValid4h = not na(obTop4h) and not na(obBot4h)

stochDiv4h      = stochDivergence(stochK, stochasticDivLenInput)
stochOversold4h = stochK < stochasticLowerInput
bbTouch4h       = close <= bb50Lower

score4h = calcScore4h(eqlPrice4h, obValid4h, stochDiv4h, stochOversold4h, bbTouch4h, dTrend)

// fractalStatus == 'ACTIVE': no entra ni antes del inicio del fractal (WAITING) ni
// después de romperse (BROKEN) — mismo gate que tick_broke_fractal en pipeline.py.
canEnter4h = score4h > scoreThresholdInput and dTrend == 1 and obValid4h and fractalStatus == 'ACTIVE'
// Flanco de subida: solo dispara en la PRIMERA barra donde la condición se cumple,
// no en cada barra mientras se mantenga — evita repetir la misma señal.
entrySignal4h = canEnter4h and not canEnter4h[1]

// --- Order Block / Equal Low activos (los que matchearon la señal), dibujados con el
// timestamp DIARIO real devuelto por dailyEngine() — mismo patrón que la caja del
// Fractal/drawOrderBlocks: var creado una vez, reposicionado. Alcance reducido a solo
// el elemento activo (no el historial completo), ver plan de esta sesión. ---
var box  activeObBox  = na
var line activeEqlLine = na

if obValid4h
    if na(activeObBox)
        activeObBox := box.new(left = obTime4h, top = obTop4h, right = last_bar_time, bottom = obBot4h, xloc = xloc.bar_time, extend = extend.right, border_color = swingBullishOrderBlockColor, bgcolor = swingBullishOrderBlockColor)
    activeObBox.set_top_left_point(chart.point.new(obTime4h, na, obTop4h))
    activeObBox.set_bottom_right_point(chart.point.new(last_bar_time, na, obBot4h))

if not na(eqlPrice4h)
    // extend.right (igual que la caja del OB) en vez de recalcular x2 cada barra —
    // el sweep es momentáneo (eqlPrice4h solo es no-na en la barra exacta del sweep),
    // así que sin extend.right la línea quedaría "congelada" sin seguir el borde
    // derecho en las barras siguientes.
    line.delete(activeEqlLine)
    activeEqlLine := line.new(x1 = eqlTime4h, y1 = eqlPrice4h, x2 = eqlTime4h, y2 = eqlPrice4h, xloc = xloc.bar_time, extend = extend.right, color = swingBullishColor, width = 1, style = line.style_dashed)

// --- Señal de entrada — label visual con el score, qué condiciones contribuyeron, y
// los 3 niveles hipotéticos de tranche (30/40/30%, mismos % que create_entries en
// strategy.py). NO hay strategy.entry(), no hay seguimiento de posición, no hay TP/SL
// — deliberadamente solo informativo en este paso (ver plan de esta sesión).
// Gateado por showEntrySignalsInput: el score/canEnter4h/entrySignal4h se siguen
// calculando igual aunque esté apagado (solo afecta si se DIBUJA la etiqueta). ---
if showEntrySignalsInput and entrySignal4h
    t1Price4h = obTop4h
    t2Price4h = (obTop4h + obBot4h) / 2.0
    t3Price4h = obBot4h
    label.new(
         bar_index,
         low * 0.999,
         "BUY SIGNAL — Score: " + str.tostring(score4h) + "\n" +
         (not na(eqlPrice4h)  ? "EQL ✓ " : "") +
         (obValid4h           ? "OB ✓ "  : "") +
         (stochDiv4h          ? "DIV ✓ " : "") +
         (bbTouch4h           ? "BB ✓ "  : "") +
         (stochOversold4h     ? "OS ✓"   : "") +
         "\nT1 " + str.tostring(t1Price4h, format.mintick) +
         "  T2 " + str.tostring(t2Price4h, format.mintick) +
         "  T3 " + str.tostring(t3Price4h, format.mintick),
         style     = label.style_label_up,
         color     = scoreSignalColorInput,
         textcolor = color.white,
         size      = size.small
     )

// Fractal — caja de seguridad (inicio/alto/bajo) + etiqueta de estado, mismo
// patrón visual que drawHighLowSwings(): objetos var creados una vez, reposicionados
// al borde derecho cada barra. El color pasa a rojo cuando el estado es BROKEN
// (irreversible). El estado en sí (fractalStatus/fractalBroken) ya se calculó más
// arriba, sin condición, en cada barra — esto solo lo dibuja.
var box   fractalBox   = na
var label fractalLabel = na

if showFractalInput and not na(fractalEffHigh) and not na(fractalEffLow)
    if na(fractalBox)
        fractalBox   := box.new(left = fractalEffStart, top = fractalEffHigh, right = fractalEffStart, bottom = fractalEffLow, xloc = xloc.bar_time, extend = extend.right, border_color = fractalColorInput, bgcolor = color.new(fractalColorInput, 90))
        fractalLabel := label.new(na, na, xloc = xloc.bar_time, color = color(na), textcolor = fractalColorInput, style = label.style_label_left, size = size.small)

    // En modo Auto, high/low/start pueden seguir moviéndose mientras crece el año en
    // curso — reposicionar la caja completa cada barra (mismos métodos que ya usa
    // drawOrderBlocks() en este fichero), no solo la etiqueta.
    fractalBox.set_top_left_point(chart.point.new(fractalEffStart, na, fractalEffHigh))
    fractalBox.set_bottom_right_point(chart.point.new(last_bar_time, na, fractalEffLow))

    if fractalStatus == 'BROKEN'
        fractalBox.set_border_color(RED)
        fractalBox.set_bgcolor(color.new(RED, 90))
        fractalLabel.set_textcolor(RED)

    fractalRightTimeBar = last_bar_time + 20 * (time - time[1])
    fractalLabel.set_point(chart.point.new(fractalRightTimeBar, na, fractalEffHigh))
    fractalLabel.set_text('Fractal: ' + fractalStatus)

//---------------------------------------------------------------------------------------------------------------------}
//ALERTS
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(currentAlerts.internalBullishBOS,        'Internal Bullish BOS',         'Internal Bullish BOS formed')
alertcondition(currentAlerts.internalBullishCHoCH,      'Internal Bullish CHoCH',       'Internal Bullish CHoCH formed')
alertcondition(currentAlerts.internalBearishBOS,        'Internal Bearish BOS',         'Internal Bearish BOS formed')
alertcondition(currentAlerts.internalBearishCHoCH,      'Internal Bearish CHoCH',       'Internal Bearish CHoCH formed')

alertcondition(currentAlerts.swingBullishBOS,           'Bullish BOS',                  'Internal Bullish BOS formed')
alertcondition(currentAlerts.swingBullishCHoCH,         'Bullish CHoCH',                'Internal Bullish CHoCH formed')
alertcondition(currentAlerts.swingBearishBOS,           'Bearish BOS',                  'Bearish BOS formed')
alertcondition(currentAlerts.swingBearishCHoCH,         'Bearish CHoCH',                'Bearish CHoCH formed')

alertcondition(currentAlerts.internalBullishOrderBlock, 'Bullish Internal OB Breakout', 'Price broke bullish internal OB')
alertcondition(currentAlerts.internalBearishOrderBlock, 'Bearish Internal OB Breakout', 'Price broke bearish internal OB')
alertcondition(currentAlerts.swingBullishOrderBlock,    'Bullish Swing OB Breakout',    'Price broke bullish swing OB')
alertcondition(currentAlerts.swingBearishOrderBlock,    'Bearish Swing OB Breakout',    'Price broke bearish swing OB')

alertcondition(currentAlerts.equalHighs,                'Equal Highs',                  'Equal highs detected')
alertcondition(currentAlerts.equalLows,                 'Equal Lows',                   'Equal lows detected')

alertcondition(currentAlerts.bullishFairValueGap,       'Bullish FVG',                  'Bullish FVG formed')
alertcondition(currentAlerts.bearishFairValueGap,       'Bearish FVG',                  'Bearish FVG formed')

//---------------------------------------------------------------------------------------------------------------------}